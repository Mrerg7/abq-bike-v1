---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const STREAM_SRC =
  'https://customer-wa9cpywo3l4jte5c.cloudflarestream.com/5298e47fe095218385a5388f34ac5763/iframe?muted=true&loop=true&autoplay=true&poster=https%3A%2F%2Fcustomer-wa9cpywo3l4jte5c.cloudflarestream.com%2F5298e47fe095218385a5388f34ac5763%2Fthumbnails%2Fthumbnail.jpg%3Ftime%3D%26height%3D600&controls=false&letterboxColor=transparent';
---

<Layout>
  <Header />

  <main class="flex-1">
    <section class="relative overflow-hidden bg-asphalt-950">
      {/*
        Mobile: Stream at native aspect (unobscured), copy sits below.
        Desktop: cinematic overlay on the same aspect frame.
      */}
      <div class="hero-stream relative w-full overflow-hidden">
        <iframe
          src={STREAM_SRC}
          title="ABQ.Bike hero video"
          class="absolute inset-0 h-full w-full border-0"
          allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
          allowfullscreen="true"
        ></iframe>
        <div
          class="pointer-events-none absolute inset-0 z-[1] hidden bg-gradient-to-t from-asphalt-950 via-asphalt-950/45 to-asphalt-950/10 sm:block"
          aria-hidden="true"
        ></div>
        <div class="absolute inset-x-0 bottom-0 z-10 hidden sm:block">
          <div class="container-narrow w-full pb-10 pt-20">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-trail-300">
              Albuquerque · Shop · Trail · Service · Rent
            </p>
            <h1 class="font-display text-6xl font-semibold uppercase leading-none tracking-wide text-white lg:text-7xl">
              ABQ<span class="text-trail-400">.Bike</span>
            </h1>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-asphalt-100/90">
              A short domain for bike shops, rentals, and ride brands in the high desert.
            </p>
            <div class="mt-8 flex flex-row gap-3">
              <a href="#ride" class="btn-primary pointer-events-auto sm:w-auto">See the Fit</a>
              <a href="#acquisition" class="btn-secondary pointer-events-auto sm:w-auto">Domain Available</a>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-asphalt-950 px-4 pb-8 pt-6 sm:hidden">
        <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-[0.22em] text-trail-300">
          Albuquerque · Shop · Trail · Service · Rent
        </p>
        <h1 class="font-display text-4xl font-semibold uppercase leading-none tracking-wide text-white">
          ABQ<span class="text-trail-400">.Bike</span>
        </h1>
        <p class="mt-2.5 max-w-xl text-sm leading-relaxed text-asphalt-100/90">
          A short domain for bike shops, rentals, and ride brands in the high desert.
        </p>
        <div class="mt-4 flex flex-col gap-2">
          <a href="#ride" class="btn-primary">See the Fit</a>
          <a href="#acquisition" class="btn-secondary">Domain Available</a>
        </div>
      </div>
    </section>

    <section id="ride" class="section-padding bg-white">
      <div class="container-narrow">
        <div class="max-w-2xl">
          <h2 class="font-display text-3xl font-semibold uppercase tracking-wide text-asphalt-950 sm:text-4xl">What the name holds</h2>
          <p class="mt-4 text-base text-asphalt-700 sm:text-lg">
            Riders search by city first. ABQ.Bike covers the shop floor, the service bench, and the trailhead without a long brand name.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:mt-12 sm:gap-6 md:grid-cols-3">
          <article class="card">
            <h3 class="font-display text-2xl font-semibold uppercase tracking-wide text-asphalt-950">Shop</h3>
            <p class="mt-2 text-sm leading-relaxed text-asphalt-600">Retail for road, gravel, mountain, and commuter builds that handle high-desert miles.</p>
          </article>
          <article class="card">
            <h3 class="font-display text-2xl font-semibold uppercase tracking-wide text-asphalt-950">Service</h3>
            <p class="mt-2 text-sm leading-relaxed text-asphalt-600">Tune-ups, suspension, and dusty-driveway repairs after foothill and Bosque rides.</p>
          </article>
          <article class="card">
            <h3 class="font-display text-2xl font-semibold uppercase tracking-wide text-asphalt-950">Rent & tour</h3>
            <p class="mt-2 text-sm leading-relaxed text-asphalt-600">Visitor rentals and guided days on paved paths and nearby singletrack.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="place" class="section-padding bg-asphalt-50">
      <div class="container-narrow grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <h2 class="font-display text-3xl font-semibold uppercase tracking-wide text-asphalt-950 sm:text-4xl">Year-round riding city</h2>
          <p class="mt-4 text-base text-asphalt-700 sm:text-lg">
            Albuquerque rides through winter sun, spring winds, and monsoon afternoons. The domain matches how locals already search.
          </p>
          <ul class="mt-8 space-y-4 text-sm text-asphalt-700 sm:text-base">
            <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-trail-500"></span><span><strong class="text-asphalt-950">Local intent</strong> — ABQ plus bike is how riders look for a shop.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-trail-500"></span><span><strong class="text-asphalt-950">Altitude miles</strong> — 5,300 feet changes pacing, hydration, and tire choice.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-trail-500"></span><span><strong class="text-asphalt-950">Trail + street</strong> — Bosque paths, foothill singletrack, and commute lanes in one market.</span></li>
          </ul>
        </div>
        <div class="rounded-2xl border border-asphalt-200 bg-white p-5 sm:p-8">
          <dl class="space-y-5">
            <div class="flex items-baseline justify-between gap-4 border-b border-asphalt-100 pb-4">
              <dt class="text-sm text-asphalt-500">Market</dt>
              <dd class="font-display text-xl font-semibold uppercase text-trail-600 sm:text-2xl">Albuquerque</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-asphalt-100 pb-4">
              <dt class="text-sm text-asphalt-500">Elevation</dt>
              <dd class="font-display text-xl font-semibold uppercase text-trail-600 sm:text-2xl">~5,300 ft</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-asphalt-100 pb-4">
              <dt class="text-sm text-asphalt-500">Brand fit</dt>
              <dd class="font-display text-xl font-semibold uppercase text-trail-600 sm:text-2xl">Shop · Service · Rent</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-sm text-asphalt-500">TLD</dt>
              <dd class="font-display text-xl font-semibold uppercase text-trail-600 sm:text-2xl">.bike</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="brand" class="section-padding bg-white">
      <div class="container-narrow max-w-3xl">
        <h2 class="font-display text-3xl font-semibold uppercase tracking-wide text-asphalt-950 sm:text-4xl">Why this domain</h2>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-asphalt-700 sm:text-base">
          <p>
            <strong class="text-asphalt-950">ABQ.Bike</strong> is city plus category on a purpose-built TLD. It works on a shop window, a jersey, and a search result.
          </p>
          <p>
            Available for a retailer, service shop, rental desk, or ride brand expanding in New Mexico.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-asphalt-200 bg-asphalt-50 py-10 sm:py-12">
      <div class="container-narrow text-center">
        <p class="mx-auto max-w-2xl text-xs leading-relaxed text-asphalt-500 sm:text-sm">
          Information presented is for demonstration and educational purposes only and does not constitute an offer of retail or ride services.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
